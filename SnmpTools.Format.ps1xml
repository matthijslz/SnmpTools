<?xml version="1.0" encoding="utf-8" ?>

<Configuration>

  <ViewDefinitions>

    <View>
      <Name>SnmpDataTable</Name>

      <ViewSelectedBy>
        <TypeName>SnmpTools.SnmpData</TypeName>
      </ViewSelectedBy>

      <TableControl>

        <AutoSize />

        <TableHeaders>

          <TableColumnHeader>
            <Label>ComputerName</Label>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Oid</Label>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Type</Label>
          </TableColumnHeader>

          <TableColumnHeader>
            <Label>Value</Label>
          </TableColumnHeader>

        </TableHeaders>

        <TableRowEntries>

          <TableRowEntry>

            <TableColumnItems>

              <TableColumnItem>
                <PropertyName>ComputerName</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Oid</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Type</PropertyName>
              </TableColumnItem>

              <TableColumnItem>
                <PropertyName>Value</PropertyName>
              </TableColumnItem>

            </TableColumnItems>

          </TableRowEntry>

        </TableRowEntries>

      </TableControl>

    </View>

  </ViewDefinitions>

</Configuration>